// Generated by visionos/CMakeLists.txt from App/RetroRewindBuild.swift.in; edit that file.

/// What this build knows about Retro Rewind: whether the RetroRewindGame framework is embedded
/// and which pack it was translated from. The mod's code is bound to that pack's Code.pul
/// (the translator refuses a base translation made without it), and the headset cannot
/// retranslate, so the launcher installs that pack version and checks the file before Play.
enum RetroRewindBuild {
    static let available = @MKW_VISIONOS_RR_AVAILABLE_SWIFT@
    /// The pack version (its version.txt) the mod was translated from; empty when the
    /// configure was not told the pack folder, in which case the newest pack is installed.
    static let packVersion = "@MKW_VISIONOS_RR_VERSION@"
    /// SHA-256 of the Binaries/Code.pul the translator consumed; empty when unknown.
    static let codePulSHA256 = "@MKW_VISIONOS_RR_CODE_PUL_SHA256@"
}
